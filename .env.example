# Configuration du vertical actif ("demenagement" ou "renovation")
NEXT_PUBLIC_VERTICAL=renovation

# URL du site en local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Placeholders Firebase fictifs (à renseigner plus tard ; aucun secret réel)
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lead-engine-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lead-engine-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lead-engine-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Script CLI d'indexation uniquement (ne pas préfixer par NEXT_PUBLIC_).
# INDEXNOW_KEY=clé-stable-optionnelle
# GOOGLE_APPLICATION_CREDENTIALS=C:/chemin/hors-depot/service-account.json
# GSC_SITE_URL=sc-domain:demenagement-local.fr

# Secrets exclusivement serveur. Ne jamais utiliser le préfixe NEXT_PUBLIC_.
OPENAI_API_KEY=
# Modèle compatible Chat Completions, JSON Schema strict et temperature.
OPENAI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL HTTPS privée du webhook administrateur (appelée après recrédit).
ADMIN_DISPUTE_WEBHOOK_URL=
# Activer Stripe Tax et configurer les immatriculations applicables avant utilisation.
# Webhook : /api/stripe/webhook ; événements checkout.session.completed
# et checkout.session.async_payment_succeeded.

# Firebase Admin : ADC sur Google Cloud, sinon compte de service serveur.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
